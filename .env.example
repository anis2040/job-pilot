# Copy to .env and fill in before `docker compose up`.
# Root .env = server config only. AI API keys are entered in the UI per user.

# Required in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Production defaults (Docker Compose sets these too)
FLASK_DEBUG=false
AUTH_DISABLED=0

# Google OAuth (required for multi-user / friends)
# Create a Web client at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match an Authorized redirect URI in Google Cloud exactly
# Local Docker:  http://localhost:5050/auth/callback/google
# Production:    https://yourdomain.com/auth/callback/google
OAUTH_REDIRECT_URI=http://localhost:5050/auth/callback/google

# Optional
HOST_PORT=5050
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=180

# Linux: match the user that owns ./data/profiles (run: id -u / id -g)
# HOST_UID=1000
# HOST_GID=1000
