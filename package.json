{
  "name": "job-scraper",
  "private": true,
  "scripts": {
    "setup:react": "npm ci --prefix frontend --include=optional --force",
    "start:react": "npm --prefix frontend run dev",
    "backend": "node scripts/dev.mjs --backend-only",
    "frontend": "node scripts/dev.mjs --frontend-only",
    "dev": "node scripts/dev.mjs",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": ".venv/bin/python -m pytest",
    "test:frontend": "npm --prefix frontend run test"
  }
}
